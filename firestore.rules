rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Users shouldn't be listable
      allow create: if isOwner(userId) && 
                      incoming().role in ['owner', 'vet'] &&
                      incoming().email == request.auth.token.email;
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber', 'specialization', 'experience', 'location']);
    }

    // Animal Rules
    match /animals/{animalId} {
      allow get: if isSignedIn(); // Potential for public view if needed, but let's restrict for privacy
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().ownerId) && isValidId(animalId);
      allow update: if isSignedIn() && isOwner(existing().ownerId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'weight', 'age', 'photoURL', 'lastVaccination', 'nextVaccination']);
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    // Appointment Rules
    match /appointments/{appointmentId} {
      function isParticipant() {
        return isSignedIn() && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.vetId);
      }
      
      allow get: if isParticipant();
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.vetId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().ownerId);
      allow update: if isParticipant() && 
                      incoming().diff(existing()).affectedKeys().hasAll(['callStatus', 'callChannelId']) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'prescriptions', 'scheduledAt', 'callStatus', 'callChannelId']);
    }
  }
}
